    "weights_licence": "Prior Labs License 1.1 (Apache 2.0 plus an attribution clause; Hugging Face license_name priorlabs-1-1); ungated download, no account or licence acceptance needed",
    "constructor": "TabPFNClassifier.create_default_for_version(ModelVersion.V2, device='cpu', random_state=528, n_preprocessing_jobs=1)",
    "n_estimators": 8,
    "softmax_temperature": 0.9,
    "device": "cpu",
    "why_not_default_v3": "tabpfn 8.x defaults to the TabPFN-3 weights, whose download requires logging in to a Prior Labs account and accepting the tabpfn-3-license-v1.0 licence (v2.5 and v2.6 likewise). That was not done. TabPFN v2 is the model described in Hollmann et al., Nature 2025."
  },
  "credentials_and_telemetry": "No Hugging Face or Prior Labs token used (HF_HUB_DISABLE_IMPLICIT_TOKEN=1; HF_TOKEN and TABPFN_TOKEN unset); licence browser flow disabled (TABPFN_NO_BROWSER=1); TabPFN telemetry disabled (TABPFN_DISABLE_TELEMETRY=1).",
  "inputs": {
    "samples_file": "config/samples.tsv",
    "samples_sha256": "7abcc9422337a01abca3518f2aaf5b883a021a0945c2d145a1a3368ea296c4ef",
