      "vst_file": "data/processed/sensitivity_with_rfprpm4/osd528_vst.tsv",
      "vst_sha256": "a9460420db2bc9ebd6253a6505fab61ccb0b3bde1fc12dabbf5115578049341c",
      "samples": [
