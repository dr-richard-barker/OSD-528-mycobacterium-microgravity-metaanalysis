        "RFPRPM41",
        "RFPRPM6"
      ],
      "n_genes_finite": 3970
    }
  },
  "design": {
    "analyses": {
      "primary": "the samples with primary == yes in config/samples.tsv",
      "sensitivity_9": "all samples in config/samples.tsv (primary plus the inferred RFPRPM4 library)"
    },
    "tasks": {
      "binary_microgravity_vs_ground": [
        "ground_1g",
        "simulated_microgravity"
      ],
      "three_class_modality": [
        "Clinostat",
        "Ground",
        "RPM"
      ]
    },
    "positive_class_for_auroc": "simulated_microgravity",
    "evaluation": "leave-one-out cross-validation over samples",
    "features": "DESeq2 VST expression; in each training fold the k genes with the highest variance across the training samples only (ties broken by gene id), standardised with training mean and SD; the held-out sample is transformed with those statistics",
    "k_values": [
      50,
      200
    ],
    "models": {
      "TabPFN_v2": "TabPFNClassifier.create_default_for_version(ModelVersion.V2, device='cpu', random_state=528, n_preprocessing_jobs=1)",
      "LogReg_L2": "sklearn LogisticRegression({'penalty': 'l2', 'C': 1.0, 'solver': 'lbfgs', 'max_iter': 10000}, random_state=528)",
      "RandomForest_500": "sklearn RandomForestClassifier({'n_estimators': 500, 'random_state': 528, 'n_jobs': 1})",
      "Majority_baseline": "sklearn DummyClassifier(strategy='prior'): predicts the training-fold majority class"
    },
    "prediction_rule": "predicted label = argmax of held-out class probabilities; ties go to the first class in the task's class list",
    "permutation_test": "the full LOOCV pipeline (feature selection, scaling, fitting) rerun under every distinct relabelling that keeps the class sizes (exact); p = fraction of relabellings, observed included, scoring >= the observed value. Monte-Carlo with seed 528 above 20000 relabellings.",
    "permutation_test_run": true,
    "min_attainable_p": "fraction of relabellings that induce the same partition of samples as the observed labels; a model that ignores class names cannot get a smaller p",
    "seed": 528
  },
